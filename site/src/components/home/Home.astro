---
import "@fontsource-variable/caveat"
import { IMAGE, lhref, REPO_URL, type Locale } from "../../lib/i18n"

/* ─── lite.spunto.net — the home page ─────────────────────────────────────
   One picture you can play with, three short beats, one command. The words
   are few on purpose: the diorama says "boxes on your laptop" faster than a
   paragraph, and the docs are one click away for everything else.

   Handwriting (Caveat) is for the margin notes only — the voice of someone
   who uses the thing, scribbling on the drawing. Young Serif carries the
   headlines, JetBrains Mono the commands. */

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const RUN = `docker run -d --name spunto-lite -p 80:80 \\
  -v /var/run/docker.sock:/var/run/docker.sock \\
  -v "$HOME/.ssh:/host-ssh:ro" \\
  -v spunto-lite-ssh-agent:/run/spunto-ssh-agent \\
  -v spunto-lite-data:/app/data \\
  ${IMAGE}:latest`

const COPY = {
  en: {
    h1a: "Make a mess.",
    h1b: "In a box.",
    sub: "Throwaway dev environments — and coding agents — on your own machine. One container. No account.",
    copy: "copy",
    copied: "copied!",
    docs: "Read the docs",
    another: "+ another box",
    running: (n: string) => `<b>${n}</b> running · all on your laptop`,
    noteLaptop: "your laptop.<br/>that's the whole cloud.",
    noteClick: "click the paper for a box,<br/>click a box to bin it",
    notesKicker: "what's in a box",
    notes: [
      ["VS Code, in a tab", "worker-a1b2.localhost"],
      ["a terminal that won’t die", "close the tab. it keeps building."],
      ["your own SSH key", "git push just works. any host."],
      ["one Postgres for all", "psql -h postgres"],
    ],
    agentH: "Hand a box<br/>to an agent.",
    agentP: "Claude Code, Codex or Mistral Vibe. Watch it type, read the diff, then keep it — or bin it.",
    agentMore: "How agent tasks work →",
    diffTitle: "fix: login breaks on Safari",
    accept: "Accept",
    drop: "Drop",
    stampAccept: "merged",
    stampDrop: "binned",
    endH: "It’s one line.",
    endNote: "psst — there’s no login screen.<br/>keep it on localhost.",
    license: "MIT · amd64 + arm64 · nothing phones home",
  },
  fr: {
    h1a: "Faites des dégâts.",
    h1b: "Dans une boîte.",
    sub: "Des environnements de dev jetables — et des agents de code — sur votre propre machine. Un conteneur. Aucun compte.",
    copy: "copier",
    copied: "copié !",
    docs: "Lire la doc",
    another: "+ une autre boîte",
    running: (n: string) => `<b>${n}</b> en route · tout sur votre portable`,
    noteLaptop: "votre portable.<br/>c’est tout le cloud.",
    noteClick: "cliquez le papier pour une boîte,<br/>une boîte pour la jeter",
    notesKicker: "dans une boîte",
    notes: [
      ["VS Code, dans un onglet", "worker-a1b2.localhost"],
      ["un terminal increvable", "fermez l’onglet. le build continue."],
      ["votre clé SSH", "git push marche. n’importe où."],
      ["un Postgres pour tous", "psql -h postgres"],
    ],
    agentH: "Confiez une boîte<br/>à un agent.",
    agentP: "Claude Code, Codex ou Mistral Vibe. Regardez-le taper, lisez le diff, puis gardez — ou jetez.",
    agentMore: "Comment marchent les tâches →",
    diffTitle: "fix : la connexion casse sous Safari",
    accept: "Accept",
    drop: "Drop",
    stampAccept: "mergé",
    stampDrop: "jeté",
    endH: "C’est une ligne.",
    endNote: "psst — il n’y a pas d’écran de connexion.<br/>gardez-le sur localhost.",
    license: "MIT · amd64 + arm64 · rien n’appelle la maison",
  },
}

const t = COPY[locale]
const docs = (p: string) => lhref(locale, `/docs${p}`)
const NOTE_COLORS = ["note-sky", "note-cream", "note-marker", "note-white"]
---

<div class="home" data-copied={t.copied} data-copy={t.copy}>
  {/* ── Hero: the diorama ─────────────────────────────────────────── */}
  <section class="hero">
    <canvas id="diorama" aria-label="Spunto Lite, drawn as a laptop with workspaces around it"></canvas>
    <div id="diorama-labels" class="diorama-layer" aria-hidden="true"></div>
    <div class="diorama-layer" aria-hidden="true">
      <p class="pin scribble" data-pin="-0.9,1.7,-1.3" style="--rot:-6deg">
        <span set:html={t.noteLaptop} />
        <svg class="arrow arrow-down-right" viewBox="0 0 80 60"><path d="M6 6 C 30 4, 52 18, 66 46 M54 42 L67 49 L70 34" /></svg>
      </p>
    </div>

    <div class="hero-copy">
      <h1>
        <span class="h1a">{t.h1a}</span>
        <span class="h1b scribble">{t.h1b}<svg class="underline" viewBox="0 0 300 24" preserveAspectRatio="none"><path d="M4 16 C 60 6, 140 4, 296 12" /></svg></span>
      </h1>
      <p class="sub">{t.sub}</p>
      <div class="cmd" data-cmd={RUN}>
        <span class="prompt">$</span>
        <code>docker run … <span class="img">spunto-lite</span></code>
        <button type="button" class="copy">{t.copy}</button>
      </div>
      <a class="docs-link" href={docs("/installation")}>{t.docs} →</a>
    </div>

    <div class="hero-tools">
      <p class="scribble hint" id="hint" set:html={t.noteClick} />
      <button type="button" id="spawn" class="spawn scribble">{t.another}</button>
      <p class="count scribble" id="count" data-tpl={t.running("{n}")} set:html={t.running("3")} />
    </div>
  </section>

  {/* ── What's in a box: four sticky notes ────────────────────────── */}
  <section class="notes">
    <p class="kicker scribble">{t.notesKicker} ↓</p>
    <ul>
      {t.notes.map(([title, line], i) => (
        <li class:list={["note", NOTE_COLORS[i]]} style={`--rot:${[-3, 2, -1.5, 3][i]}deg`}>
          <span class="tape" />
          <p class="note-title scribble">{title}</p>
          <code>{line}</code>
        </li>
      ))}
    </ul>
  </section>

  {/* ── Agents: the review, as a stamp ────────────────────────────── */}
  <section class="agent">
    <div class="agent-copy">
      <h2 set:html={t.agentH} />
      <p>{t.agentP}</p>
      <a href={docs("/agents")}>{t.agentMore}</a>
    </div>
    <div class="review" id="review">
      <div class="review-head">
        <span class="bot" aria-hidden="true"><i></i><i></i></span>
        <span class="review-title">{t.diffTitle}</span>
      </div>
      <div class="diff">
        <span class="ctx">  const session = await</span>
        <span class="del">-   cookies.get("sid")</span>
        <span class="add">+   cookies.get("sid", &#123; sameSite: "lax" &#125;)</span>
        <span class="ctx">  if (!session) return login()</span>
        <span class="add">+ // Safari drops it otherwise</span>
      </div>
      <div class="review-actions">
        <button type="button" data-stamp="accept">{t.accept}</button>
        <button type="button" data-stamp="drop">{t.drop}</button>
      </div>
      <div class="stamp" id="stamp" data-accept={t.stampAccept} data-drop={t.stampDrop}></div>
    </div>
  </section>

  {/* ── The end: one command ──────────────────────────────────────── */}
  <section class="end">
    <h2>{t.endH}</h2>
    <div class="end-cmd">
      <pre><code>{RUN}</code></pre>
      <button type="button" class="copy" data-cmd={RUN}>{t.copy}</button>
    </div>
    <p class="scribble end-note" set:html={t.endNote} />
    <div class="end-links">
      <a class="btn" href={docs("/installation")}>{t.docs} →</a>
      <a class="btn-ghost" href={REPO_URL}>GitHub</a>
    </div>
    <p class="license">{t.license}</p>
  </section>
</div>

<script>
  import { Diorama } from "./diorama"

  const root = document.querySelector<HTMLElement>(".home")!
  const copyLabel = root.dataset.copy!
  const copiedLabel = root.dataset.copied!

  // Copy buttons.
  root.querySelectorAll<HTMLButtonElement>(".copy").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const cmd = btn.dataset.cmd ?? btn.closest<HTMLElement>("[data-cmd]")?.dataset.cmd ?? ""
      await navigator.clipboard.writeText(cmd)
      btn.textContent = copiedLabel
      setTimeout(() => (btn.textContent = copyLabel), 1600)
    })
  })

  // The review card: a stamp, each click.
  const stamp = document.getElementById("stamp")!
  root.querySelectorAll<HTMLButtonElement>("[data-stamp]").forEach((btn) =>
    btn.addEventListener("click", () => {
      const kind = btn.dataset.stamp as "accept" | "drop"
      stamp.textContent = stamp.dataset[kind]!
      stamp.className = `stamp is-${kind}`
      stamp.style.setProperty("--r", `${(Math.random() * 16 - 12).toFixed(1)}deg`)
      void stamp.offsetWidth
      stamp.classList.add("is-on")
    }),
  )

  // The diorama.
  const canvas = document.getElementById("diorama") as HTMLCanvasElement
  const countEl = document.getElementById("count")!
  const hint = document.getElementById("hint")!
  const tpl = countEl.dataset.tpl!
  const css = getComputedStyle(root)
  const v = (n: string) => css.getPropertyValue(n).trim()
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches

  try {
    const d = new Diorama({
      canvas,
      labels: document.getElementById("diorama-labels")!,
      palette: { ink: v("--d-ink"), sky: v("--d-sky"), paper: v("--d-paper"), marker: v("--d-marker"), cream: v("--d-cream") },
      reducedMotion,
      onCountChange: (n) => (countEl.innerHTML = tpl.replace("{n}", String(n))),
    })
    document.querySelectorAll<HTMLElement>("[data-pin]").forEach((el) => {
      const [x, y, z] = el.dataset.pin!.split(",").map(Number)
      d.pin(el, [x, y, z])
    })
    const first: Parameters<Diorama["spawn"]>[0][] = [
      { color: "ink", name: "worker-a1b2", slot: 2 },
      { agent: true, color: "marker", name: "claude", slot: 3 },
      { color: "sky", slot: 1 },
    ]
    first.forEach((o, i) => setTimeout(() => d.spawn(o), reducedMotion ? 0 : 500 + i * 450))
    const dismiss = () => hint.classList.add("is-gone")
    canvas.addEventListener("click", dismiss, { once: true })
    document.getElementById("spawn")!.addEventListener("click", () => {
      d.spawn()
      dismiss()
    })
  } catch {
    // No WebGL: the copy still stands on its own.
    root.classList.add("no-webgl")
  }
</script>

<style is:global>
  .home {
    --d-paper: #efe9dc;
    --d-ink: #172a4d;
    --d-sky: #84d4f7;
    --d-marker: #ff6a3d;
    --d-cream: #fbf7ee;
    --hand: "Caveat Variable", "Caveat", cursive;
    background: var(--d-paper);
    color: var(--d-ink);
    /* A faint paper grain: two offset dot grids, no image. */
    background-image:
      radial-gradient(color-mix(in oklch, var(--d-ink) 7%, transparent) 0.6px, transparent 0.7px),
      radial-gradient(color-mix(in oklch, var(--d-ink) 5%, transparent) 0.5px, transparent 0.6px);
    background-size: 22px 22px, 31px 31px;
    background-position: 0 0, 11px 7px;
  }
  .dark .home {
    --d-paper: #101c33;
    --d-ink: #eef3fb;
    color: var(--d-ink);
  }
  /* The nav and the footer sit on the same paper. */
  html:has(.home) {
    --background: #efe9dc;
    --border: color-mix(in oklch, #172a4d 14%, transparent);
  }
  html.dark:has(.home) {
    --background: #101c33;
  }
  .scribble {
    font-family: var(--hand);
    font-weight: 600;
  }

  /* ── Hero ───────────────────────────────────────────────────────── */
  .home .hero {
    position: relative;
    height: 100svh;
    min-height: 640px;
    overflow: hidden;
  }
  .home #diorama {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: copy;
    touch-action: pan-y;
  }
  .home .diorama-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .diorama-label {
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    white-space: nowrap;
    padding: 3px 7px;
    border-radius: 4px;
    background: color-mix(in oklch, var(--d-cream) 92%, transparent);
    color: #172a4d;
    border: 1px solid color-mix(in oklch, #172a4d 15%, transparent);
    transition: opacity 0.3s, background 0.2s;
  }
  .diorama-label.is-hover {
    background: #172a4d;
    color: var(--d-cream);
  }
  .diorama-label.is-leaving {
    opacity: 0 !important;
  }
  .home .pin {
    position: absolute;
    left: 0;
    top: 0;
    font-size: 22px;
    line-height: 1.05;
    color: var(--d-marker);
    white-space: nowrap;
    rotate: var(--rot);
    translate: -105% -120%;
  }
  .home .pin.is-covered {
    opacity: 0.12;
  }
  .home .pin {
    transition: opacity 0.3s;
  }
  .home .arrow {
    position: absolute;
    width: 64px;
    height: 48px;
    right: -54px;
    bottom: -40px;
    fill: none;
    stroke: var(--d-marker);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .home .hero-copy {
    position: absolute;
    left: clamp(20px, 5vw, 72px);
    top: clamp(88px, 14vh, 150px);
    max-width: 34rem;
    pointer-events: none;
  }
  .home .hero-copy > * {
    pointer-events: auto;
  }
  .home h1 {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.92;
    font-size: clamp(3rem, 8.2vw, 6.6rem);
  }
  .home .h1a {
    display: block;
  }
  .home .h1b {
    position: relative;
    display: inline-block;
    font-size: 1.12em;
    letter-spacing: -0.01em;
    color: var(--d-marker);
    rotate: -3deg;
    margin-top: 0.08em;
  }
  .home .underline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.1em;
    width: 100%;
    height: 0.22em;
    fill: none;
    stroke: var(--d-marker);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 320;
    stroke-dashoffset: 320;
    animation: draw 0.9s 0.5s cubic-bezier(0.6, 0, 0.3, 1) forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .home .sub {
    margin-top: 1.6rem;
    max-width: 27rem;
    font-size: 17px;
    line-height: 1.5;
    color: color-mix(in oklch, var(--d-ink) 78%, transparent);
  }
  .home .cmd {
    margin-top: 1.6rem;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 9px 9px 16px;
    border-radius: 999px;
    background: #172a4d;
    color: #eef3fb;
    font-family: var(--font-mono);
    font-size: 13.5px;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.05), 0 12px 30px -12px rgba(23, 42, 77, 0.6);
  }
  .home .cmd .prompt {
    color: var(--d-sky);
  }
  .home .cmd .img {
    color: var(--d-sky);
  }
  .home .copy {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--d-sky);
    color: #172a4d;
    cursor: pointer;
    transition: transform 0.15s;
  }
  .home .copy:hover {
    transform: rotate(-3deg) scale(1.05);
  }
  .home .docs-link {
    display: block;
    width: fit-content;
    margin-top: 1rem;
    margin-left: 6px;
    font-size: 14.5px;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--d-marker);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .home .hero-tools {
    position: absolute;
    right: clamp(20px, 5vw, 72px);
    bottom: clamp(24px, 6vh, 56px);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    pointer-events: none;
  }
  .home .hero-tools > * {
    pointer-events: auto;
  }
  .home .hint {
    font-size: 21px;
    line-height: 1.05;
    text-align: right;
    color: color-mix(in oklch, var(--d-ink) 60%, transparent);
    rotate: -2deg;
    transition: opacity 0.6s, translate 0.6s;
  }
  .home .hint.is-gone {
    opacity: 0;
    translate: 0 8px;
  }
  .home .spawn {
    font-size: 27px;
    padding: 4px 20px 8px;
    border: 2.5px solid var(--d-ink);
    border-radius: 14px 18px 12px 20px / 18px 12px 20px 14px;
    background: var(--d-cream);
    color: #172a4d;
    rotate: 1.5deg;
    box-shadow: 4px 5px 0 var(--d-ink);
    cursor: pointer;
    transition: transform 0.12s, box-shadow 0.12s;
  }
  .home .spawn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 6px 7px 0 var(--d-ink);
  }
  .home .spawn:active {
    transform: translate(3px, 4px);
    box-shadow: 1px 1px 0 var(--d-ink);
  }
  .home .count {
    font-size: 20px;
    color: color-mix(in oklch, var(--d-ink) 70%, transparent);
  }
  .home .count b {
    color: var(--d-marker);
    font-size: 1.3em;
  }
  .home.no-webgl .hero-tools,
  .home.no-webgl .pin {
    display: none;
  }

  /* ── Notes ──────────────────────────────────────────────────────── */
  .home .notes {
    padding: clamp(56px, 10vh, 110px) clamp(20px, 5vw, 72px);
    max-width: 1200px;
    margin: 0 auto;
  }
  .home .kicker {
    font-size: 26px;
    color: var(--d-marker);
    rotate: -2deg;
    width: fit-content;
  }
  .home .notes ul {
    margin-top: 1.6rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: clamp(18px, 3vw, 34px);
  }
  .home .note {
    position: relative;
    padding: 30px 22px 24px;
    min-height: 170px;
    rotate: var(--rot);
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.06), 0 14px 24px -14px rgba(23, 42, 77, 0.45);
    transition: rotate 0.25s, translate 0.25s;
    color: #172a4d;
  }
  .home .note:hover {
    rotate: 0deg;
    translate: 0 -6px;
  }
  .home .note-sky {
    background: #c6ecfc;
  }
  .home .note-cream {
    background: #fff4c7;
  }
  .home .note-marker {
    background: #ffd2bf;
  }
  .home .note-white {
    background: #fdfcf8;
  }
  .home .tape {
    position: absolute;
    top: -11px;
    left: 50%;
    width: 78px;
    height: 22px;
    translate: -50% 0;
    rotate: -4deg;
    background: color-mix(in oklch, #ffffff 55%, transparent);
    border: 1px solid rgba(23, 42, 77, 0.06);
  }
  .home .note-title {
    font-size: 30px;
    line-height: 1;
  }
  .home .note code {
    display: block;
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: 12px;
    opacity: 0.75;
  }

  /* ── Agent ──────────────────────────────────────────────────────── */
  .home .agent {
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(40px, 8vh, 90px) clamp(20px, 5vw, 72px);
    display: grid;
    gap: clamp(32px, 6vw, 90px);
    align-items: center;
  }
  @media (min-width: 900px) {
    .home .agent {
      grid-template-columns: 1fr 1.1fr;
    }
  }
  .home h2 {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.98;
    font-size: clamp(2.4rem, 5.4vw, 4.2rem);
  }
  .home .agent-copy p {
    margin-top: 1.2rem;
    max-width: 26rem;
    font-size: 17px;
    line-height: 1.5;
    color: color-mix(in oklch, var(--d-ink) 78%, transparent);
  }
  .home .agent-copy a {
    display: inline-block;
    margin-top: 1.1rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--d-marker);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .home .review {
    position: relative;
    background: #fdfcf8;
    color: #172a4d;
    border-radius: 6px;
    padding: 20px;
    rotate: 1.2deg;
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.06), 0 30px 50px -28px rgba(23, 42, 77, 0.55);
  }
  .home .review-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .home .bot {
    display: inline-flex;
    gap: 5px;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 30px;
    border-radius: 9px;
    background: #0b1730;
  }
  .home .bot i {
    width: 6px;
    height: 6px;
    border-radius: 99px;
    background: #84d4f7;
    animation: blink 4s infinite;
  }
  @keyframes blink {
    0%,
    96%,
    100% {
      transform: scaleY(1);
    }
    98% {
      transform: scaleY(0.1);
    }
  }
  .home .review-title {
    font-weight: 600;
    font-size: 15px;
  }
  .home .diff {
    margin-top: 16px;
    padding: 14px 0;
    border-radius: 4px;
    background: #f3f1ea;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.75;
    overflow-x: auto;
  }
  .home .diff span {
    display: block;
    padding: 0 14px;
    white-space: pre;
  }
  .home .diff .del {
    background: #ffe1d6;
    color: #a3341a;
  }
  .home .diff .add {
    background: #dcf5e6;
    color: #17703f;
