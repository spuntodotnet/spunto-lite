---
import { SpuntoLogo } from "@spunto/design-system/brand"
import { lhref, REPO_URL, SPUNTO_URL, UI, type Locale } from "../lib/i18n"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = UI[locale]
const links: [string, string][] = [
  [t.docs, lhref(locale, "/docs")],
  [t.github, REPO_URL],
  ["spunto.net", locale === "fr" ? `${SPUNTO_URL}/fr` : SPUNTO_URL],
]
---

<footer class="border-t border-border">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-5 py-10 md:flex-row md:items-center md:justify-between md:px-10">
    <div class="flex items-center gap-3">
      <SpuntoLogo tone="product" size={24} />
      <div>
        <p class="font-display text-sm font-bold tracking-tight">Spunto Lite</p>
        <p class="text-xs text-muted-foreground">{t.footerTagline}</p>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-muted-foreground">
      {links.map(([label, href]) => <a href={href} class="transition-colors hover:text-foreground">{label}</a>)}
    </div>
    <p class="text-xs text-muted-foreground/70">
      <a href={locale === "fr" ? `${SPUNTO_URL}/fr` : SPUNTO_URL} class="hover:text-foreground">{t.footerBy}</a> · {t.license} · {t.builtOn}
      <a href="https://ui.shadcn.com" class="hover:text-foreground">shadcn/ui</a>
    </p>
  </div>
</footer>
